__pycache__/
*.pyc
*.egg-info/
dist/
build/
.env
.venv/
*.orarep
flagged/
submissions/

# Heavy paper-v1 payloads: per-turn obs + minimap base64 JSONLs
# (commit the _summary.json + _invocation.json only)
data/runs/paper-v1-**/*.jsonl
data/runs/paper-v1-**/*.partial
data/runs/paper-v1-**/*.png
data/runs/paper-v1-**/.logs/
data/runs/_archive_*/

# Site E2E test infra (PR #19)
node_modules/

# Local Playback fixtures (smoke tests / temp runs)
playback/_smoke/

# Canonical consolidated result/ tree (tools/consolidate_results.py).
# We commit the lightweight text artifacts + indexes, but keep the
# bulky per-turn minimap PNGs and the per-turn message transcript
# (with inlined base64 image data URLs) OUT of git — they're trivially
# reproducible from data/runs/ via the consolidator.
result/**/seed*/minimap_turn*.png
result/**/seed*/messages.json

# Staging dirs auto-created by external scripts before --family flag
# existed; the canonical approach is `--family f1,f2,...` against
# `openra_bench/scenarios/packs/` directly. These dirs are derived
# artifacts, never committed.
data/packs-*-v*/
data/packs-family*/
data/packs-f3to10*/

# Backups of .env (contain old API keys — never commit)
.env.bak
.env.*.bak
